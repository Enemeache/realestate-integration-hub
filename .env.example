MONGO_URI=mongodb://localhost:27017
MONGO_DB=propleads
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
LEADS_QUEUE=leads.incoming
# Opcional: sin esta key el clasificador usa una heurística local (ver app/llm.py)
ANTHROPIC_API_KEY=
EMBEDDING_ENGINE=tfidf
LOG_LEVEL=INFO
# Opcional: si se configura, /webhook/lead exige el header X-Signature (HMAC-SHA256)
WEBHOOK_SECRET=
# "rabbitmq" (default) o "kafka" -- ver app/broker.py
MESSAGE_BROKER=rabbitmq
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
